{
	email {$ACME_EMAIL}
}

(app) {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@backend path /api/* /mcp /mcp/* /media/* /.well-known/* /oauth/token /oauth/register /oauth/revoke
	handle @backend {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000 {
			flush_interval -1
		}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN}, googlebusiness.{$DOMAIN}, playreview.{$DOMAIN}, instagram.{$DOMAIN}, facebook.{$DOMAIN}, ads.{$DOMAIN} {
	import app
}

api.{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy api:4000 {
		flush_interval -1
	}
}

api.qualify.{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy qualify-api:3100 {
		lb_policy least_conn
		health_uri /health
		health_interval 10s
		fail_duration 30s
		flush_interval -1
	}
}
